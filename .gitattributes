# Padronização de line endings (LF para repositórios multiplataforma)
* text=auto eol=lf

# Arquivos de documentação, instruções e scripts Unix/Python em LF
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Scripts PowerShell mantidos com CRLF/LF tolerante
*.ps1 text eol=crlf
